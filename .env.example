# 실제 값은 .env 에 넣는다 (이 파일은 키 이름만 문서화, git 커밋용)

# LS증권 Open API — https://openapi.ls-sec.co.kr/
ls_security_key=      # LS APP_KEY (발급받은 앱키)
ls_serect_key=        # LS APP_SECRET (앱 시크릿 — APP_KEY와 반드시 다른 값)

# Tavily 검색 API — https://tavily.com  (뉴스 재료 팩트체크 → 점수 반영)
tavily_api_key=

# 멀티 LLM 서술 (점수엔 관여 안 함 — 서술/시나리오 전용)
perplexity_api=       # Perplexity — 실시간 리서치
google_gemini_api=    # Google Gemini — 초안·수치 교차검증
claude_api=           # Anthropic Claude — 최종 합성·매매 결론

# 엔진별 모델명 (선택 — 비우면 코드 기본값). 콤마로 폴백 체인 지정 가능(앞이 우선).
# perplexity_model=sonar                          # 예: sonar-pro
# gemini_model=gemini-2.5-flash,gemini-2.0-flash  # 앞 실패 시 뒤로 폴백
# claude_model=claude-opus-5,claude-sonnet-5       # 과부하 시 sonnet 으로 강등

# 운영 토글 / 게이트 (서버 전용)
# auto_update=true     # false 면 예약(cron) 실행 건너뜀. 수동 TUI 는 막지 않음.
# BTC_LEVERAGE=5       # 바이낸스 배수 (TUI가 out/btc_size.json 에 저장하면 그쪽 우선)
# BTC_MARGIN=1000      # Isolated 증거금 USDT
# view_password=       # Vercel 대시보드 로그인 비번
# auth_token=          # Vercel 게이트 쿠키 서명 토큰
